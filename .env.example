# Required
ANTHROPIC_API_KEY=

# Optional — web search for verifying new/unknown tech (skipped if unset)
TAVILY_API_KEY=

# Optional — per-run token cost aggregation
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=project-reviewer

# Models (hybrid): cheap subagents, stronger orchestrator
REVIEWER_MODEL=claude-haiku-4-5-20251001
REVIEWER_ORCH_MODEL=claude-sonnet-4-6

# Safety bound on the orchestrator graph's supersteps
REVIEWER_RECURSION_LIMIT=60
